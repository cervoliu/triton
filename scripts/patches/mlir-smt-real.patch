+  LogicalResult visitSMTOp(RealConstantOp op, mlir::raw_indented_ostream &stream,
+                           ValueMap &valueMap) {
+    // The attribute holds an SMT-LIB real term emitted verbatim. Guard against
+    // injection: the value must use only the characters of a real literal
+    // (digits, '.', '/', unary '-', parentheses, spaces) AND be structurally a
+    // single balanced closed term. The character check alone is not enough:
+    // "1.0 1.0" or "0.0)" would splice extra operands into (or unbalance) the
+    // enclosing s-expression, making the exported formula differ from the IR.
+    StringRef value = op.getValue();
+    auto isSingleClosedTerm = [](StringRef v) {
+      v = v.trim(" \t");
+      if (v.empty())
+        return false;
+      if (v.front() != '(')
+        return v.find_first_of(" \t()") == StringRef::npos;
+      int depth = 0;
+      for (size_t i = 0, e = v.size(); i != e; ++i) {
+        if (v[i] == '(')
+          ++depth;
+        else if (v[i] == ')' && --depth == 0)
+          return i + 1 == e;
+      }
+      return false; // unbalanced
+    };
+    if (value.find_first_not_of("0123456789./- ()\t") != StringRef::npos ||
+        !isSingleClosedTerm(value))
+      return op.emitError(
+                 "smt.real.constant value is not a valid real literal: ")
+             << value;
+    valueMap.insert(op.getResult(), value.str());
+    return success();
+  }
