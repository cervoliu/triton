+#ifndef MLIR_DIALECT_SMT_IR_SMTREALOPS_TD
+#define MLIR_DIALECT_SMT_IR_SMTREALOPS_TD
+
+include "mlir/Dialect/SMT/IR/SMTDialect.td"
+include "mlir/Dialect/SMT/IR/SMTTypes.td"
+include "mlir/IR/EnumAttr.td"
+include "mlir/IR/OpAsmInterface.td"
+include "mlir/Interfaces/SideEffectInterfaces.td"
+
+// Note: `SMTOp` is defined in SMTOps.td and `IntPredicate` in SMTIntOps.td, both
+// of which are included before this file by SMT.td.
+
+class SMTRealOp<string mnemonic, list<Trait> traits = []> :
+  SMTOp<"real." # mnemonic, traits>;
+
+def RealConstantOp : SMTRealOp<"constant", [Pure]> {
+  let summary = "produce a constant real";
+  let description = [{
+    This operation represents a constant of the `Real` sort as described in the
+    [SMT Reals theory](https://smtlib.cs.uiowa.edu/Theories/Reals.smt2) of the
+    SMT-LIB 2.7 standard. The `value` attribute holds the constant already
+    rendered as an SMT-LIB real term (e.g. `0.0`, `2.0`, `(- 1.0)`, `(/ 1 3)`),
+    which is emitted verbatim during SMT-LIB export.
+
+    Example:
+    ```mlir
+    %c = smt.real.constant "0.0" : !smt.real
+    ```
+  }];
+
+  let arguments = (ins StrAttr:$value);
+  let results = (outs RealType:$result);
+  let assemblyFormat = "$value attr-dict";
+}
+
+class VariadicRealOp<string mnemonic> : SMTRealOp<mnemonic, [Pure, Commutative]> {
+  let description = [{
+    This operation represents }] # summary # [{. The semantics are equivalent to
+    the corresponding operator described in the
+    [SMT Reals theory](https://smtlib.cs.uiowa.edu/Theories/Reals.smt2) of the
+    SMT-LIB 2.7 standard.
+  }];
+
+  let arguments = (ins Variadic<RealType>:$inputs);
+  let results = (outs RealType:$result);
+  let assemblyFormat = "$inputs attr-dict";
+}
+
+class BinaryRealOp<string mnemonic> : SMTRealOp<mnemonic, [Pure]> {
+  let description = [{
+    This operation represents }] # summary # [{. The semantics are equivalent to
+    the corresponding operator described in the
+    [SMT Reals theory](https://smtlib.cs.uiowa.edu/Theories/Reals.smt2) of the
+    SMT-LIB 2.7 standard.
+  }];
+
+  let arguments = (ins RealType:$lhs, RealType:$rhs);
+  let results = (outs RealType:$result);
+  let assemblyFormat = "$lhs `,` $rhs attr-dict";
+}
+
+def RealAddOp : VariadicRealOp<"add"> { let summary = "real addition"; }
+def RealMulOp : VariadicRealOp<"mul"> { let summary = "real multiplication"; }
+def RealSubOp : BinaryRealOp<"sub"> { let summary = "real subtraction"; }
+def RealDivOp : BinaryRealOp<"div"> { let summary = "real division"; }
+
+def RealNegOp : SMTRealOp<"neg", [Pure, SameOperandsAndResultType]> {
+  let summary = "real unary negation";
+  let description = [{
+    This operation represents the unary minus of the `Real` sort as described in
+    the [SMT Reals theory](https://smtlib.cs.uiowa.edu/Theories/Reals.smt2) of
+    the SMT-LIB 2.7 standard.
+  }];
+
+  let arguments = (ins RealType:$input);
+  let results = (outs RealType:$result);
+  let assemblyFormat = "$input attr-dict";
+}
+
+def RealCmpOp : SMTRealOp<"cmp", [Pure, SameTypeOperands]> {
+  let summary = "real comparison";
+  let description = [{
+    This operation represents the comparison of reals. The semantics are
+    equivalent to the `<= (le)`, `< (lt)`, `>= (ge)`, or `> (gt)` operator
+    depending on the predicate (indicated in parentheses), as described in the
+    [SMT Reals theory](https://smtlib.cs.uiowa.edu/Theories/Reals.smt2) of the
+    SMT-LIB 2.7 standard. The `IntPredicate` enum is reused since the ordered
+    comparison predicates are identical.
+  }];
+
+  let arguments = (ins IntPredicate:$pred, RealType:$lhs, RealType:$rhs);
+  let results = (outs BoolType:$result);
+  let assemblyFormat = "$pred $lhs `,` $rhs attr-dict";
+}
+
+#endif // MLIR_DIALECT_SMT_IR_SMTREALOPS_TD
